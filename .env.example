# ── LEXICON .env.example ──────────────────────────────────────────────────────
# Copy this file to .env and fill in your keys.
#   cp .env.example .env
#
# NEVER commit .env — it is listed in .gitignore.

# ── Groq API Keys (primary + fallback) ───────────────────────────────────────
# Required. At least one Groq key must be set.
# Get a free key at: https://console.groq.com
GROQ_API_KEY=gsk_...
GROQ_API_KEY2=                      # Optional second key for rate-limit rotation

# ── Tavily API Keys ───────────────────────────────────────────────────────────
# Required for web-search retrieval mode.
# Get a free key at: https://app.tavily.com
TAVILY_API_KEY=tvly-...
TAVILY_API_KEY2=                    # Optional second key

# ── OpenRouter (LLM fallback) ─────────────────────────────────────────────────
# Optional. Used when all Groq keys are exhausted.
# Get a key at: https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-...

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Optional. Without this the app uses in-memory persistence (data lost on restart).
#
# Option A — MongoDB Atlas (cloud):
#   MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
#
# Option B — Local Docker Compose MongoDB (run with: docker compose --profile mongo up):
#   MONGODB_URI=mongodb://mongo:27017/research_platform
#
# Leave blank to use in-memory mode (suitable for local demos):
MONGODB_URI=
MONGODB_DB_NAME=research_platform

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# IMPORTANT: Change JWT_SECRET_KEY to a long random string in production.
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_STRONG_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── OCR (optional — only needed for scanned PDFs) ─────────────────────────────
# In Docker, Tesseract and Poppler are installed in the container automatically.
# These variables are only needed for native (non-Docker) local development
# on Windows where the binaries are not on PATH.
OCR_TESSERACT_CMD=
OCR_POPPLER_PATH=

# ── Docker Compose host ports ─────────────────────────────────────────────────
# Change these if the defaults conflict with other services on your machine.
LEXICON_BACKEND_PORT=8000
LEXICON_FRONTEND_PORT=3000
LEXICON_MONGO_PORT=27017

# ── Frontend API URL (Docker Compose build arg) ───────────────────────────────
# In Docker Compose, the default "/api" allows the frontend's nginx to reverse-proxy
# all API calls to the backend container without CORS or hardcoded hostnames.
# For standalone local dev (npm run dev), use: http://localhost:8000
VITE_API_URL=/api
